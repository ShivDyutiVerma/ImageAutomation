# Copy to .env and edit as needed. Every value is optional — the defaults
# shown here are what the code uses when the variable is absent.
#
# Relative paths are resolved against the project root, never the directory
# you happen to run the command from.

# --- Browser connection -----------------------------------------------------
# Chrome must already be running with:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="<repo>/flow/_profile"
FLOW_CDP_URL=http://localhost:9222

# --- Paths ------------------------------------------------------------------
FLOW_PROMPTS_FILE=prompts/prompts.txt
FLOW_OUTPUT_DIR=output
FLOW_MANIFEST_FILE=output/manifest.json

# --- Timing (seconds) -------------------------------------------------------
# How long to wait for the Flow UI to show a Create button.
FLOW_READY_TIMEOUT=60
# How long a single image generation may take before it counts as failed.
FLOW_GENERATION_TIMEOUT=180
# How often to check whether a new image has appeared.
FLOW_POLL_INTERVAL=2
# Pause between prompts, to avoid hammering the UI.
FLOW_DELAY_BETWEEN_PROMPTS=3

# --- Retry behaviour --------------------------------------------------------
# Attempts per prompt before it's recorded as failed.
FLOW_MAX_ATTEMPTS=3
# Backoff base in seconds; attempt N waits N * this.
FLOW_RETRY_BACKOFF=10

# When this many prompts fail back to back, pause instead of continuing to
# hammer a broken session or exhausted credits.
FLOW_CONSECUTIVE_FAILURE_LIMIT=5

# What happens at that pause: wait this long, then try again, up to this
# many times. Most things that trip the limit above (a brief Flow outage, a
# momentary rate limit, credits that top up on a schedule) resolve within
# minutes on their own, so this bridges those automatically. If it's still
# failing after all the cooldowns, the run gives up for real — set
# MAX_COOLDOWNS=0 to skip straight to that (the old, pre-cooldown behavior).
FLOW_COOLDOWN_SECONDS=300
FLOW_MAX_COOLDOWNS=3

# --- Download ---------------------------------------------------------------
FLOW_DOWNLOAD_TIMEOUT=120
FLOW_DOWNLOAD_ATTEMPTS=3

# --- Flow UI fingerprints ---------------------------------------------------
# Override these if Google changes the Flow UI and the automation stops
# finding images or the project tab. See tests/manual/inspect_flow_dom.py.
FLOW_IMAGE_URL_MARKER=media.getMediaUrlRedirect
FLOW_ORIGIN=https://labs.google
FLOW_PROJECT_URL_MARKER=/flow/project/
FLOW_TOOLS_URL_MARKER=/fx/tools/flow

# --- Project selection -------------------------------------------------------
# If the open Chrome tab is on the Flow landing page rather than inside a
# project, the automation navigates in automatically. It will NEVER guess
# among several existing projects — set this to pin a run to one of them.
# Example: https://labs.google/fx/tools/flow/project/<your-project-id>
FLOW_PROJECT_URL=

# If no projects exist yet and FLOW_PROJECT_URL isn't set, click "New
# project" automatically. Off by default because it mutates your account.
FLOW_AUTO_CREATE_PROJECT=false
FLOW_NEW_PROJECT_TIMEOUT=30

# --- Chrome auto-launch -------------------------------------------------------
# If Chrome isn't already reachable at FLOW_CDP_URL, launch it automatically
# against the already-authenticated profile below. This never touches your
# Google login — it only starts a process against a profile you already
# logged into by hand (see tests/manual/flow_profile_setup.py). Set to false
# to manage Chrome yourself.
FLOW_AUTO_LAUNCH_CHROME=true
FLOW_CHROME_PROFILE_DIR=flow/_profile
# Set this if chrome.exe isn't in a common install location or on PATH.
FLOW_CHROME_EXECUTABLE=
FLOW_CHROME_LAUNCH_TIMEOUT=30
